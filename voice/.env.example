# IntelliVox voice backend — copy to .env and adjust

# ── Agent behavior ────────────────────────────────────────────────────────────
INTELLIVOX_ENGLISH_ONLY=true
INTELLIVOX_NON_ENGLISH_REJECT_PROB=0.35
INTELLIVOX_MAX_REPLANS=2

# Chrome profile folder (Default, Profile 1, …). Leave unset to auto-detect.
# INTELLIVOX_CHROME_PROFILE=Default

# Vision model for computer_use (optional)
# INTELLIVOX_VISION_MODEL=llava:7b

# ── Opik tracing (optional — disabled by default) ───────────────────────────
OPIK_DISABLED=true

# Enable local Opik (Docker — see OBSERVABILITY.md):
# OPIK_DISABLED=
# OPIK_USE_LOCAL=true
# OPIK_URL_OVERRIDE=http://localhost:5173/api
# OPIK_WORKSPACE=default

# Enable Comet cloud (after: opik configure):
# OPIK_DISABLED=
# OPIK_ENABLED=true
